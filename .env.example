# Frontend address used for reset-password links and CORS.
FRONTEND_URL=http://localhost:9000

# Google OAuth 2.0 Web client ID. Create this in Google Cloud Console and add
# your frontend URLs to Authorized JavaScript origins (for example localhost:9000).
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# JWT signing key and access-token lifetime.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# SMTP settings for password-reset emails.
# Gmail example: use smtp.gmail.com, port 587, and a Google App Password.
# Never commit real SMTP credentials to source control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=BotBuilder <your-email@gmail.com>
