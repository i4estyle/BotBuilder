# ==========================================
# Database Configuration (MySQL)
# ==========================================
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root1234
DB_NAME=BotBuilder
# Set DB_SSL=true when connecting to cloud MySQL providers (e.g. Aiven)
DB_SSL=false
# For production TLS verification, Base64-encode the provider CA PEM and set:
# DB_SSL_CA_BASE64=<base64-of-ca-pem>
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Connection resilience (recommended production defaults; safe for TiDB Cloud Starter)
DB_CONNECT_RETRY_ATTEMPTS=10
DB_CONNECT_RETRY_DELAY_MS=3000
DB_POOL_MAX=5

# ==========================================
# Application & Authentication
# ==========================================
PORT=3000
# Comma-separated list of allowed frontend origins for CORS and password reset links
FRONTEND_URL=http://localhost:9000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m


# ==========================================
# Google Sheets API Configuration
# ==========================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheet-reader@botbuilder-sheets.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=1OQ8X-6bmzj6DEsOMToPMNwE0AikWgqalzhTJXeZs57k
GOOGLE_SHEET_NAME=Sheet1

# Public Google OAuth 2.0 Web client ID (Optional for Google Sign-in)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# ==========================================
# SMTP Email Configuration (Password Reset)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=BotBuilder <your-email@gmail.com>
