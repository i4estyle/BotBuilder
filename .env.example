# Frontend address used for email links and CORS.
FRONTEND_URL=http://localhost:9000
# JWT signing key and access-token lifetime.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
# SMTP settings. If omitted in development, email links are logged by the backend.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=BotBuilder <no-reply@example.com>
